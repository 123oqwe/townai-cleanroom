{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web-next",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/v1/(.*)", "destination": "/api" }],
  "crons": [{ "path": "/v1/internal/worker", "schedule": "0 * * * *" }]
}
