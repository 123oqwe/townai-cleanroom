{
  "name": "townai-cleanroom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven clean-room implementation of a durable personal AI operating system.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "vercel:protect": "node scripts/configure-vercel-protection.mjs",
    "check:source": "node scripts/check-source-only.mjs",
    "check:web": "node scripts/check-web.mjs",
    "verify": "pnpm check:source && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "24.13.3",
    "eslint": "10.0.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
