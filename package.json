{
  "name": "townai-cleanroom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven clean-room implementation of a durable personal AI operating system.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.30.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "vercel:protect": "node scripts/configure-vercel-protection.mjs",
    "check:source": "node scripts/check-source-only.mjs",
    "check:runtime-config": "node scripts/check-runtime-config.mjs",
    "check:build-entries": "node scripts/check-build-entries.mjs",
    "check:web": "node scripts/check-web.mjs",
    "verify": "pnpm check:source && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:build-entries"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "24.13.3",
    "eslint": "10.0.0",
    "hono": "4.12.29",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
