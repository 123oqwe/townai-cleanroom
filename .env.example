DATABASE_URL=
CREDENTIAL_MASTER_KEY_BASE64URL=
ACCESS_ALLOWLIST_EMAILS=
ADMIN_ALLOWLIST_EMAILS=
PORT=3000
WEB_ORIGIN=http://localhost:3001
TOWN_API_VERSION=development
RESPONSES_API_ENDPOINT=https://api.openai.com/v1/responses
RESPONSES_MODEL=gpt-5
RESPONSES_API_KEY=
WORKER_ENABLED=false
WORKER_ID=town-worker-local
WORKER_SECRET=
CRON_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
TELEGRAM_SECRET_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
E2B_API_KEY=
PIPEDREAM_API_URL=https://api.pipedream.com/v1/apps
PIPEDREAM_API_KEY=

# Codex harness (uses official @openai/codex-sdk from openai/codex)
CODEX_EXEC_ENABLED=false
CODEX_MODEL=
CODEX_SANDBOX_MODE=read-only
CODEX_CLI_PATH=

# Rate limiting: "memory" (default, in-process) or "db" (PostgreSQL-backed, multi-instance)
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ===========================================================================
# Phase 01A: Production Authentication (Google OIDC login)
# ===========================================================================
# Authentication OAuth (login only -- openid/email/profile). MUST be separate
# from the connected-account GOOGLE_OAUTH_* vars below, which are for
# Gmail/Calendar integration.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# High-entropy random shared secret between the Next.js BFF and the API.
# Server-only; never use NEXT_PUBLIC_. >= 32 chars.
AUTH_BFF_SHARED_SECRET=
# 32-byte base64url key for encrypting short-lived OIDC code_verifier at rest.
# Separate from CREDENTIAL_MASTER_KEY_BASE64URL.
AUTH_FLOW_ENCRYPTION_KEY_BASE64URL=
# Comma-separated allowed origins for CSRF (no wildcard). Production required.
AUTH_ALLOWED_ORIGINS=http://localhost:3001
# Signup authorization mode: "allowlist" (default) or "open".
# Allowlist is checked AFTER OIDC identity verification only.
AUTH_SIGNUP_MODE=allowlist
# DEV ONLY: email-only login. Forbidden in production (startup fails).
DEV_EMAIL_LOGIN_ENABLED=false
# Server-only API base URL for the BFF proxy (never NEXT_PUBLIC_).
INTERNAL_API_BASE_URL=http://127.0.0.1:3000
# Session lifetimes (ms). Cookie TTL matches the absolute TTL.
AUTH_SESSION_IDLE_TTL_MS=900000
AUTH_SESSION_ABSOLUTE_TTL_MS=604800000
